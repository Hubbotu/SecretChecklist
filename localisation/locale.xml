<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
  <!-- Load English (default/fallback) first -->
  <Script file="enUS.lua"/>
  <!-- Load other locales (only the active one will apply) -->
  <Script file="deDE.lua"/>
  <Script file="esES.lua"/>
  <Script file="esMX.lua"/>
  <Script file="frFR.lua"/>
  <Script file="itIT.lua"/>
  <Script file="ptBR.lua"/>
  <Script file="ruRU.lua"/>
  <Script file="koKR.lua"/>
  <Script file="zhCN.lua"/>
  <Script file="zhTW.lua"/>
  <!--
    Data strings (step labels, notes, sources, descriptions). Keyed by their
    English text rather than by an id -- see SC:T in SecretChecklist.lua.
    Generated and refreshed by tools/extract-strings.py; each file returns
    immediately unless its locale is active.
  -->
  <Script file="data\deDE.lua"/>
  <Script file="data\ruRU.lua"/>
</Ui>