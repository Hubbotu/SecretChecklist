package-as: SecretChecklist

enable-nolib-creation: no

ignore:
  - README.md
  - .git
  - .gitignore
  - .github
  - .luacheckrc
  - .release
  - tools
  # Store-page copy for CurseForge and Wago. Kept in the repo so it is version
  # controlled and editable, but it is not part of the addon.
  - docs

license-output: LICENSE

# Release notes on CurseForge and Wago come from this file rather than from the
# commit log, which is written for maintainers and not for players.
#
# It holds ONLY the version being released. It used to point at CHANGELOG.md,
# which is cumulative -- so every release page carried every previous release's
# notes underneath it, growing without bound. Rewrite this file for each
# release; CHANGELOG.md keeps the full history for the repository.
manual-changelog:
  filename: RELEASE_NOTES.md
  markup-type: markdown
